# Neon Postgres connection string (production)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT signing secret (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# Server
PORT=8080
HOST=0.0.0.0

# Optional: set false after first migrate if you manage schema yourself
# DB_SYNC=true

# Skip demo seed
# SKIP_SEED=true

# Local SQLite path when DATABASE_URL is unset
# SQLITE_PATH=./data/forgeledger.sqlite
